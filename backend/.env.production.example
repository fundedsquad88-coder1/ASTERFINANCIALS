# Copy this file to .env.production on the deployment host.
# Never commit the real production file or its credentials.

POSTGRES_USER=aster
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aster
DATABASE_URL=postgresql://aster:replace-with-a-long-random-password@postgres:5432/aster?schema=public

PORT=3000
NODE_ENV=production

ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# One of: SUPER_ADMIN, OPERATIONS, COMPLIANCE, FINANCE, SUPPORT
ADMIN_ROLE=SUPER_ADMIN
# Keep false only for the current sandbox/admin bootstrap. Production should use true after MFA challenge flow is deployed.
ADMIN_MFA_REQUIRED=false

# Public web origins allowed to call the API. Configure these on the deployment host.
# Example: https://asterfinancials.com,https://www.asterfinancials.com
ALLOWED_ORIGINS=https://your-domain.example

# Required to show live Gold, Silver, WTI and Brent commodity data.
TWELVEDATA_API_KEY=replace-with-your-twelve-data-api-key

# Custodial USDT deposit monitoring. Use unique deposit addresses per customer and network.
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=replace-with-your-trongrid-api-key
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_CONFIRMATIONS=1

# BSC JSON-RPC provider used for BEP-20 USDT Transfer log monitoring.
# Use a provider that supports eth_getLogs; BSC public endpoints may disable it.
BSC_RPC_URL=https://your-bsc-rpc-provider.example
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_CONFIRMATIONS=15
BSC_SCAN_BLOCKS=500

# How often the backend scans active customer deposit addresses.
CUSTODY_SCAN_INTERVAL_MS=30000

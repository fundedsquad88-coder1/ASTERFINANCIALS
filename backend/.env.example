# Copy this file to .env for local development, then replace placeholders.
# Production secrets must be configured in the deployment secret manager, not committed.

# Database connection. Use PostgreSQL for staging/production.
DATABASE_URL=postgresql+psycopg://aster:replace-this-password@localhost:5432/aster
SESSION_TTL_HOURS=24
# Local HTTP development: false/lax. For the Android app and cross-site HTTPS,
# set SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Exact frontend origins; never use a wildcard with credentialed requests.
ALLOWED_ORIGINS=https://appassets.androidplatform.net,https://asterfinancials.netlify.app,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate a unique random value of at least 32 characters.
ASTER_ADMIN_API_KEY=

# Blockchain scanning is opt-in and must remain disabled until allocation,
# treasury custody, chain cursors, and provider approvals are reviewed.
ASTER_BSC_RPC_URL=
ASTER_BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ASTER_BSC_CONFIRMATIONS=12
# Do not leave this at 0 when enabling mainnet scanning; set a reviewed start block.
ASTER_BSC_START_BLOCK=0
ASTER_BSC_LOG_BATCH=2000

ASTER_TRON_ENABLED=false
ASTER_TRON_API_URL=https://api.trongrid.io
ASTER_TRON_API_KEY=
ASTER_TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
ASTER_TRON_CONFIRMATIONS=1
# Do not leave this at 0 when enabling mainnet scanning; set a reviewed start timestamp.
ASTER_TRON_START_MS=0
ASTER_TRON_PAGE_SIZE=200
ASTER_TRON_MAX_PAGES=10

ASTER_BLOCKCHAIN_POLL_SECONDS=15
# Single-wallet deposit ticket lifetime; server clamps this to 30-60 minutes.
ASTER_DEPOSIT_TICKET_TTL_MINUTES=45
ASTER_CHAIN_HTTP_TIMEOUT=15

# Keep provider integration disabled until a provider has approved Aster's model.
ASTER_FUNDING_PROVIDER=aster-treasury
ASTER_FUNDING_WEBHOOK_SECRET=
ASTER_AUTOINVEST_EXECUTION_PROVIDER=disabled
